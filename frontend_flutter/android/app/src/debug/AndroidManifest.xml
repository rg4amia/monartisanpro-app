<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Le développement local parle en HTTP au backend Laravel (localhost,
         10.0.2.2 pour l'émulateur, ou une IP du LAN découverte par
         NetworkDiscoveryService). On réactive donc le trafic en clair pour ce
         seul variant : le manifeste principal l'interdit, afin que l'APK
         distribué n'accepte que HTTPS. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic"/>
</manifest>
