APP_NAME=ProsArtisan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONT_URL=https://www.prosartisan.net

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_TELEGRAM_LEVEL=error

# Alertes Telegram (production)
# Exemple prod:
# LOG_STACK=daily,telegram_bot
# APP_ENV=production
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OneSignal (Notifications Push)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ── SMS Pro Africa ───────────────────────────────────────────────────────────
SMS_PROVIDER=smspro
SMS_API_TOKEN=
SMS_BASE_URL=https://app.smspro.africa/api/v3
SMS_SENDER_ID=ProsArtisan

# ── WhatsApp API ──────────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=log
WHATSAPP_API_TOKEN=
WHATSAPP_BASE_URL=https://api.whatsapp.com/v1

# ── Yandex Maps (console yandex.ru/maps-api/console — une clé par API, ──────────
#    restreinte package+SHA-1 / bundle id, avec quota)
# Distance Matrix API — distances/durées réelles (coût de livraison, ETA)
YANDEX_DISTANCE_MATRIX_API_KEY=
# Geolocation API — position approximative wifi/cellulaire (fallback)
YANDEX_GEOLOCATION_API_KEY=
# MapKit SDK — rendu carte côté mobile (injecté au build Flutter)
YANDEX_MAPKIT_API_KEY=

# ── OSRM — routage réel (dernier repli si Yandex indisponible) ───────
# Défaut : serveur de démonstration public, rate-limité, sans SLA. Pointer
# vers une instance dédiée en production.
OSRM_BASE_URL=https://router.project-osrm.org

# ── Passerelles USSD / SMS entrant ────────────────────────────────────────────
# OBLIGATOIRE en production. /api/v1/ussd et /api/v1/sms/incoming valident les
# retraits et les livraisons, donc libèrent des fonds. La passerelle opérateur
# doit présenter ce secret, soit dans l'en-tête `X-Gateway-Secret` (recommandé),
# soit — si elle ne permet pas d'en-tête personnalisé, cas fréquent chez les
# opérateurs SMS — en paramètre d'URL `?gateway_secret=…`. Tant qu'il est vide,
# les deux endpoints répondent 503 : jamais de porte ouverte par défaut.
# `php artisan gateway:callback-url --reveal` affiche les URL prêtes à coller
# dans le tableau de bord SMSpro.
USSD_GATEWAY_SECRET=
# Liste blanche d'IP facultative (séparées par des virgules), en défense
# supplémentaire si l'opérateur publie des IP sortantes fixes.
USSD_GATEWAY_IPS=
# Secret de signature SMSpro, à récupérer sur leur page « Developer settings ».
# SMSpro signe chaque webhook en HMAC-SHA256 du corps brut (`X-Webhook-Signature:
# sha256=…`). C'est la méthode la plus sûre : la signature couvre le contenu du
# message, là où le secret partagé n'authentifie que l'appelant. Renseigné, il
# est vérifié en priorité ; le secret partagé reste utile pour la passerelle
# USSD, qui est un autre opérateur.
SMSPRO_WEBHOOK_SECRET=

# ── Webhooks de paiement ──────────────────────────────────────────────────────
# OBLIGATOIRE en production : sans ce secret, la signature HMAC des webhooks
# Wave serait calculable par n'importe qui et les confirmations de paiement
# deviendraient forgeables. Le webhook est refusé tant qu'il est vide.
WAVE_WEBHOOK_SECRET=
