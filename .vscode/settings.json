{
  "claudeCode.useTerminal": true,
  "kiroAgent.configureMCP": "Disabled",
  "vscode-edge-devtools.webhint": false,
  "java.project.excludePaths": [
    "**/node_modules",
    "**/.metadata",
    "**/archetype",
    "**/bin",
    "**/frontend_flutter/build",
    "**/build"
  ],
  // frontend_flutter/android est un projet Gradle Android imbriqué dans le
  // projet Flutter : sans cette exclusion, l'extension Java (Red Hat) et
  // l'extension Gradle l'importent et le re-synchronisent en tâche de fond
  // via leur propre démon Gradle (sous le JBR d'Android Studio), qui entre
  // en concurrence avec `flutter build apk` / `gradlew` lancés en CLI sur le
  // même dossier `build/` — verrous de fichiers Windows intermittents
  // (« Unable to delete directory », tâche et sous-dossier différents à
  // chaque essai) qui font échouer le build release au hasard.
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.metadata/**",
    "**/archetype-resources/**",
    "**/META-INF/maven/**",
    "**/frontend_flutter/**"
  ],
  "gradle.autoDetect": "off",
  "files.exclude": {
    "**/frontend_flutter/build": true,
    "**/build": true,
    "**/.dart_tool": true
  },
  "files.watcherExclude": {
    "**/frontend_flutter/build/**": true,
    "**/build/**": true,
    "**/.dart_tool/**": true,
    "**/ios/Flutter/ephemeral/**": true,
    "**/macos/Flutter/ephemeral/**": true,
    "**/linux/flutter/ephemeral/**": true,
    "**/windows/flutter/ephemeral/**": true
  },
  "java.configuration.updateBuildConfiguration": "interactive",
  "claudeCode.enableNewConversationShortcut": true,
  "claudeCode.preferredLocation": "sidebar"
}