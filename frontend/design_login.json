{
 "design_system_name": "MinimalAuthMobile",
 "design_style": {
  "aesthetic": "Minimal, soft, modern, mobile-first",
  "visual_tone": "Calm, trustworthy, lightweight",
  "density": "Comfortable spacing with generous padding",
  "corner_style": "Rounded, soft edges",
  "shadow_style": "Very subtle or none",
  "border_usage": "Light neutral borders for input fields and secondary buttons",
  "contrast_strategy": "Primary action uses strong color; rest relies on grayscale hierarchy"
 },
 "layout": {
  "platform": "Mobile",
  "safe_area_respected": true,
  "alignment": "Centered vertical stack",
  "content_width": "Full width with horizontal padding",
  "horizontal_padding": 24,
  "vertical_flow_spacing": {
   "xs": 8,
   "sm": 12,
   "md": 16,
   "lg": 24,
   "xl": 32
  },
  "structure_order": [
   "Logo/Brand Mark",
   "Title",
   "Subtitle",
   "Primary Social Buttons",
   "Divider With Label",
   "Input Fields",
   "Auxiliary Link",
   "Primary CTA Button",
   "Secondary Action Text"
  ]
 },
 "color_system": {
  "primary": {
   "base": "#1F6FD6",
   "hover": "#1A5FC0",
   "pressed": "#174FA8",
   "text_on_primary": "#FFFFFF"
  },
  "background": {
   "screen": "#F5F6F8",
   "card": "#FFFFFF"
  },
  "neutral": {
   "900": "#111111",
   "700": "#444444",
   "500": "#888888",
   "300": "#DADADA",
   "200": "#EAEAEA",
   "100": "#F2F2F2"
  },
  "semantic": {
   "error": "#E5484D",
   "success": "#2FB344",
   "warning": "#F5A524",
   "info": "#3B82F6"
  }
 },
 "typography": {
  "font_family": "Modern Sans-Serif (e.g., Inter, SF Pro, Roboto)",
  "scale": {
   "display": {
    "size": 28,
    "weight": 700,
    "line_height": 1.2
   },
   "heading": {
    "size": 22,
    "weight": 600,
    "line_height": 1.3
   },
   "subheading": {
    "size": 16,
    "weight": 400,
    "line_height": 1.5
   },
   "body": {
    "size": 15,
    "weight": 400,
    "line_height": 1.5
   },
   "button": {
    "size": 16,
    "weight": 600,
    "line_height": 1.2
   },
   "caption": {
    "size": 13,
    "weight": 400,
    "line_height": 1.4
   }
  },
  "text_colors": {
   "primary": "neutral.900",
   "secondary": "neutral.700",
   "muted": "neutral.500",
   "link": "primary.base"
  }
 },
 "radius": {
  "input": 12,
  "button": 12,
  "pill": 999
 },
 "components": {
  "logo": {
   "shape": "Circular mark",
   "background_color": "primary.base",
   "alignment": "Centered",
   "spacing_bottom": 24
  },
  "title_block": {
   "title_style": "heading",
   "subtitle_style": "subheading",
   "alignment": "center",
   "spacing_bottom": 24
  },
  "social_button": {
   "height": 52,
   "border_radius": 12,
   "background": "background.card",
   "border": "1px solid neutral.300",
   "icon_position": "left",
   "text_alignment": "center",
   "text_style": "button",
   "spacing_between_buttons": 16
  },
  "divider_with_label": {
   "line_color": "neutral.200",
   "text_style": "caption",
   "text_color": "neutral.500",
   "layout": "horizontal line with centered text"
  },
  "input_field": {
   "height": 52,
   "border_radius": 12,
   "background": "background.card",
   "border": "1px solid neutral.300",
   "padding_horizontal": 16,
   "placeholder_color": "neutral.500",
   "text_style": "body",
   "states": {
    "default": {
     "border_color": "neutral.300"
    },
    "focus": {
     "border_color": "primary.base",
     "outline": "none"
    },
    "error": {
     "border_color": "semantic.error"
    },
    "disabled": {
     "background": "neutral.100",
     "text_color": "neutral.500"
    }
   },
   "icon_support": {
    "right_icon_supported": true,
    "icon_opacity": 0.7
   }
  },
  "link": {
   "style": "text only",
   "color": "primary.base",
   "font_weight": 500,
   "underline": false
  },
  "primary_button": {
   "height": 56,
   "border_radius": 12,
   "background": "primary.base",
   "text_color": "primary.text_on_primary",
   "text_style": "button",
   "full_width": true,
   "states": {
    "hover": {
     "background": "primary.hover"
    },
    "pressed": {
     "background": "primary.pressed"
    },
    "disabled": {
     "background": "neutral.300",
     "text_color": "neutral.500"
    }
   }
  },
  "secondary_text_action": {
   "alignment": "center",
   "text_style": "body",
   "link_embedded": true
  }
 },
 "interaction_patterns": {
  "focus_behavior": "Highlight active input with primary color border",
  "button_feedback": "Color darkens slightly on press",
  "input_icons": "Tappable visibility toggle supported",
  "link_behavior": "Color emphasis without underline",
  "keyboard_aware_layout": true
 },
 "spacing_system": {
  "base_unit": 8,
  "scale": [
   4,
   8,
   12,
   16,
   24,
   32,
   40,
   48
  ]
 },
 "accessibility": {
  "minimum_touch_target": 44,
  "color_contrast": "WCAG AA minimum",
  "text_scaling_supported": true,
  "focus_visible": true
 },
 "animation": {
  "duration_fast": 150,
  "duration_standard": 250,
  "easing": "ease-in-out",
  "button_press_scale": 0.98,
  "transition_style": "Subtle fade and scale"
 }
}